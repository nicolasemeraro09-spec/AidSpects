      "parameters": {
        "jsCode": "const items = $input.all();\nconst dataOra = new Date().toLocaleString('it-IT');\n\nconst escapeHtml = (str) =>\n  String(str ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n\nconst blocchi = items.map((item, i) => {\n  const domanda = escapeHtml(item.json.domanda_paziente || 'Domanda non disponibile');\n  const risposta = escapeHtml(item.json.risposta_occhiali || 'Risposta non disponibile');\n  return `\n    <div class=\"scambio\">\n      <div class=\"badge\">Interazione ${i + 1}</div>\n      <div class=\"msg paziente\">\n        <span class=\"ruolo\">Paziente (Occhiali)</span>\n        <p>${domanda}</p>\n      </div>\n      <div class=\"msg assistente\">\n        <span class=\"ruolo\">Assistente AI</span>\n        <p>${risposta}</p>\n      </div>\n    </div>`;\n}).join('\\n');\n\nconst html = `<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Riepilogo Assistente Occhiali Smart</title>\n  <style>\n    body { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; background: #f8fafc; color: #0f172a; margin: 0; padding: 32px 16px; }\n    .container { max-width: 760px; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 32px; box-shadow: 0 10px 25px rgba(15,23,42,0.06); }\n    h1 { margin: 0 0 6px; font-size: 22px; color: #0f172a; }\n    .meta { color: #64748b; font-size: 13px; margin-bottom: 28px; border-bottom: 1px solid #e2e8f0; padding-bottom: 16px; }\n    .scambio { margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px dashed #cbd5e1; }\n    .scambio:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }\n    .badge { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #0284c7; margin-bottom: 10px; }\n    .msg { padding: 12px 16px; border-radius: 10px; margin-bottom: 10px; }\n    .paziente { background: #f1f5f9; border-left: 4px solid #64748b; }\n    .assistente { background: #eff6ff; border-left: 4px solid #0284c7; }\n    .ruolo { display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; }\n    .msg p { margin: 0; font-size: 15px; line-height: 1.5; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <h1>Riepilogo Conversazione — Occhiali Smart AI</h1>\n    <div class=\"meta\">Generato il ${dataOra} · Totale interazioni: ${items.length}</div>\n    ${blocchi}\n  </div>\n</body>\n</html>`;\n\nreturn [{ json: { html } }];"
      },
